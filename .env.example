# 複製成 .env 後填值。.env 已被 .gitignore 擋住，不會進 repo。
#
# 這個檔案只放「非機密設定」。
# AWS 憑證不要寫在這裡，見下方說明。

# --- Bedrock 設定（非機密）---------------------------------------------------
AWS_REGION=us-east-1

# Nova 2 等模型在美國以外需要跨區推論設定（CRIS），裸 model id 會被拒。
# 可用前綴：global. / us. / eu. / apac.
BEDROCK_MODEL_ID=global.amazon.nova-2-lite-v1:0

LLM_PROVIDER=bedrock

# --- 快取與產出路徑（非機密）-------------------------------------------------
NLSC_TILE_CACHE=_tile_cache
ROAD_CACHE_DIR=_road_cache
ZONE_MAP_CACHE=_result_cache
ZONE_MAP_ARCHIVE=artifacts

# 分區圖路徑；支援 .shp 或 .parquet
# NTPC_ZONING_SHP=新北市使用分區/新北市使用分區.shp

# --- API 服務（機密，只有走 zone_map_api.py 才需要）-------------------------
# 逗號分隔。留空代表不驗證，對外部署務必設定。
# ZONE_MAP_API_KEYS=

# --- AWS 憑證：請勿寫在這裡 --------------------------------------------------
#
# 本機開發：用 aws configure 寫進 ~/.aws/credentials，再設 AWS_PROFILE
#     aws configure --profile hackathon
#     AWS_PROFILE=hackathon
#
# ECS / Fargate：不需要任何金鑰。設定 task definition 的 taskRoleArn，
#     附上只含 bedrock:InvokeModel 的政策即可，憑證由容器自動取得並輪替。
#
# EC2：用 instance profile。Lambda：用 execution role。
#
# 只有在 AWS 之外執行且無法用 role 時才需要長期金鑰，
# 此時請存進 Secrets Manager，不要放檔案。
