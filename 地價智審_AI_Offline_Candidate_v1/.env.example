# .env.example — 地價智審 AI
#
# 複製此檔案為 .env 並填入實際值（.env 本身已列於 .gitignore，不會被commit）。
# 本檔案僅含變數名稱與安全placeholder，不含任何真實憑證。
#
# 本地Mock Mode開發（tests/、providers/ Mock實作）不需要設定任何以下變數，
# 這些變數僅於實際部署至AWS Lambda執行環境時，由 infra/template.yaml
# 之 Environment.Variables 自動注入（見該檔案對應設定）。

# DynamoDB 案件資料表名稱（對應 infra/template.yaml::CasesTable）
CASES_TABLE_NAME=AIValuationCases

# S3 Bucket 名稱，供PDF輸出使用（對應 infra/template.yaml::PdfBucket）
PDF_BUCKET_NAME=ai-valuation-pdfs-REPLACE_WITH_YOUR_ACCOUNT_ID

# S3 Bucket 名稱，供使用者上傳來源文件使用（對應 infra/template.yaml::DocumentBucket）
DOCUMENT_BUCKET_NAME=ai-valuation-documents-REPLACE_WITH_YOUR_ACCOUNT_ID

# Lambda 日誌等級
LOG_LEVEL=INFO

# Bedrock Foundation Model ID（對應 infra/template.yaml::BedrockModelId Parameter）
# 見 docs/phase7/aws_services.md Part F；此為Explanation功能專用，
# 不影響Grade/Adjustment/Calculation等核心deterministic邏輯。
# 注意（RC1-AUDIT-1發現）：ExplanationFunction目前在infra/template.yaml
# 沒有任何API Gateway路由或已部署的StateMachine觸發它，設定此變數本身
# 不代表AI摘要功能已可被呼叫，見docs/release/RC1_FULL_PROJECT_AUDIT_
# REPORT.md之P1-1。
BEDROCK_MODEL_ID=anthropic.claude-3-5-sonnet-20241022-v2:0

# ---------------------------------------------------------------
# DATA_PROVIDER_MODE — Mock / Real 資料來源總開關（對應
# backend/handlers/collect_data.py::_resolve_data_provider_mode()）。
#
#   未設定（或留白）＝預設"mock"，讀取10個MockXxxProvider，不對外發出
#   任何真實網路請求。
#   設為"real"＝改用10個RealXxxProvider（含真實NTPC OpenData本地snapshot
#   查詢、NLSC座標解析等），找不到官方資料時誠實回報UNKNOWN／
#   DATASET_UNAVAILABLE，絕不悄悄fallback回Mock或Golden數字。
#   設為其他任何值＝直接raise RuntimeError（INVALID_DATA_PROVIDER_MODE），
#   不會被當成"mock"處理——修正環境變數本身，而非依賴預設值。
#
# infra/template.yaml目前未設定此變數（故部署後預設即為mock模式），
# 若要在真實AWS環境測試Real Provider，需自行於
# `sam deploy --parameter-overrides` 或Lambda主控台額外加上此變數。
# ---------------------------------------------------------------
DATA_PROVIDER_MODE=mock

# ---------------------------------------------------------------
# Cadastral Snapshot Bootstrap（對應 infra/template.yaml 之
# CadastralSnapshotBucketName/CadastralSnapshotS3Key/
# CadastralSnapshotSha256 Parameters，由 CollectDataFunction 於冷啟動時
# 讀取，見 backend/handlers/cadastral_snapshot_bootstrap.py）。
# 三者缺一即回報DATASET_UNAVAILABLE，不嘗試下載，不使用checksum不符
# 的檔案。
# ---------------------------------------------------------------

# 存放 data/cadastral_dataset_cache.sqlite3（~407MB）之外部S3 bucket，
# 此bucket刻意不由CloudFormation stack建立/管理，需部署者自行準備。
CADASTRAL_SNAPSHOT_S3_BUCKET=REPLACE_WITH_YOUR_CADASTRAL_SNAPSHOT_BUCKET

# 該snapshot物件之S3 key（每次resync需發布新key，不可覆寫既有key）
CADASTRAL_SNAPSHOT_S3_KEY=datasets/cadastral/v2026-09-06/cadastral_dataset_cache.sqlite3

# 該snapshot物件之SHA-256（必須與實際上傳物件逐位元組相符，見
# docs/release/RC1_AWS_PREREQUISITES.md）
CADASTRAL_SNAPSHOT_SHA256=d2ffbe849c21273a0a6602ce25b58e940d23125c9bba779b34e1a5b589656e42

# Lambda執行環境內下載後之本地暫存路徑（固定值，Real Cadastral
# Provider與bootstrap模組皆讀此路徑，兩者必須一致，不建議修改）
CADASTRAL_DATASET_CACHE_DB_PATH=/tmp/cadastral_dataset_cache.sqlite3

# ---------------------------------------------------------------
# NLSC CAD_001（CadasMapPosition，宗地代表座標）— Auth-Gated功能旗標
# （對應 providers/official_parcel_coordinate_provider.py）。
#
# 現況（見docs/release/RC1_FULL_PROJECT_AUDIT_REPORT.md）：NLSC會員
# 資格/API金鑰尚未申請，以下4個變數目前應保持未設定／false。
# ---------------------------------------------------------------

# 功能旗標，預設"false"。設為"true"本身不代表已完成官方授權，只是
# 允許程式碼嘗試呼叫CAD_001（若無有效憑證仍會回報AUTH_REQUIRED）。
NLSC_CAD_API_ENABLED=false

# 僅供SOURCE-CODE-LEVEL稽核使用之旗標。絕對不可在正式環境設為"true"，
# 除非NLSC官方Auth傳輸機制已重新稽核確認——見該Provider模組docstring
# 之明確警告。
NLSC_CAD_AUTH_CONTRACT_VERIFIED=false

# NLSC API帳號（申請後填入，切勿commit真實值）
NLSC_CAD_API_USERNAME=

# NLSC API金鑰（申請後填入，切勿commit真實值）
NLSC_CAD_API_TOKEN=

# Shared non-secret defaults are in .env.shared.example and loaded automatically.
# Set these in your local .env; existing shell environment takes precedence.
APP_MODE=local
API_BASE_URL=
AWS_PROFILE=
AWS_DEFAULT_REGION=ap-northeast-1
AWS_REGION=us-west-2
ARTIFACT_API_REGION=us-west-2
ARTIFACT_API_URL=https://zyte6qrr2k.execute-api.us-west-2.amazonaws.com
RAG_API_TOKEN=
RAG_MODE=mock
RAG_ALLOWED_PROJECTS=demo-a,demo-b
# Leave empty to use backend/rag_service/data.
RAG_DATA_DIR=
PORT=8090

# ---------------------------------------------------------------
# 選用調校參數（有安全預設值，通常不需修改；僅在需要調整上傳大小上限
# 或Presigned URL有效期時才設定）
# ---------------------------------------------------------------

# 文件上傳大小上限（bytes），對應 backend/handlers/document_extract.py。
# 預設 20MB（20*1024*1024）。
MAX_DOCUMENT_SIZE_BYTES=20971520

# S3 Presigned Upload URL 有效秒數，對應
# backend/handlers/document_upload.py。預設3600秒（1小時）。
DOCUMENT_UPLOAD_URL_EXPIRES_IN=3600

# ---------------------------------------------------------------
# 以下由 AWS CLI / SAM CLI 標準機制管理，不透過本檔案設定，僅供說明：
#   AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY / AWS_SESSION_TOKEN
#   （請使用 `aws configure` 或 IAM Role，切勿寫入任何.env檔案）
#   AWS_DEFAULT_REGION（建議 ap-northeast-1，見
#   docs/phase7/aws_deployment_runbook.md）
#
# 以下為測試專用之本地SQLite路徑覆寫（讓pytest可指向暫存DB），非
# 部署必要項，正式環境不需設定，故不列於本檔案：
#   DATASET_REGISTRY_DB_PATH / FACILITY_DATASET_CACHE_DB_PATH /
#   NLSC_CODE_CACHE_DB_PATH
# ---------------------------------------------------------------
