# 地價智審：完整環境設定清單
# 複製為專案根目錄 .env。空白表示尚待提供或沿用程式預設，不代表已連線。
# 優先序：終端機環境變數 > .env > .env.shared.example。
# 不支援 ${VAR} 展開；同一 bucket 用於多個欄位時，請各自填完整名稱。
# 正式密鑰只放 .env；本範本可提交 Git。SAM/Lambda 仍須另行注入環境變數。

# 1. 主程式／前端 API
# local=本機後端；mock=示範資料；production=正式 API，必填下列 HTTPS 網址。
APP_MODE=local
# 主系統 API Gateway URL 尚未提供；不可拿 artifact URL 代替。
API_BASE_URL=
LOG_LEVEL=INFO
DATA_PROVIDER_MODE=mock
SEMANTIC_RULE_MAPPING_PROVIDER_MODE=mock

# 2. AWS 認證：選擇 profile 或 access-key 認證，避免混填。
# 已設定 AWS CLI/SSO 時填 profile；使用 IAM role 時以下憑證欄位留白。
AWS_PROFILE=
# 使用 access key 時成對填入。臨時憑證必須同時填 AWS_SESSION_TOKEN。
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=
# 選用：覆寫 AWS CLI/SDK 憑證與 config 檔案位置，通常留白。
AWS_SHARED_CREDENTIALS_FILE=
AWS_CONFIG_FILE=
# 主 SAM stack 與預設 boto3 區域。
AWS_DEFAULT_REGION=ap-northeast-1
# RAG 程式明確讀取此區域；artifact 另讀 ARTIFACT_API_REGION。
AWS_REGION=us-west-2
# 僅本機 AWS 模擬器使用，真 AWS 必須留白。
LOCAL_AWS_ENDPOINT_URL=

# 3. 主系統 DynamoDB 與 S3（正式 bucket 名稱尚未提供）
CASES_TABLE_NAME=AIValuationCases
PDF_BUCKET_NAME=
DOCUMENT_BUCKET_NAME=
MAX_DOCUMENT_SIZE_BYTES=20971520
DOCUMENT_UPLOAD_URL_EXPIRES_IN=3600

# 4. Artifact API／儲存服務（依專案既有部署描述，未重新連線驗證）
ARTIFACT_API_URL=https://zyte6qrr2k.execute-api.us-west-2.amazonaws.com
ARTIFACT_API_REGION=us-west-2
# 以下 BUCKET/TABLE 是 artifact Lambda 讀取的變數，不是主系統的 bucket/table。
BUCKET=ntpc-appraisal-artifacts-137336531963-us-west-2
TABLE=ntpc-appraisal-metadata-v1
# Artifact JSON/PDF object key 由 /v1/imports 回傳，不是固定環境變數。
# 認證採 AWS IAM SigV4，沒有另需填寫的 artifact API key。

# 5. RAG／Bedrock
# 本機 .env 會建立隨機 token；隊友自行建立，不使用共用公開 token。
RAG_API_TOKEN=
RAG_MODE=mock
RAG_ALLOWED_PROJECTS=demo-a,demo-b
# 留白即使用 backend/rag_service/data；自訂時請填存在的完整路徑。
RAG_DATA_DIR=
PORT=8090
# 實際使用需帳號在 AWS_REGION 具有對應模型或 inference profile 權限。
BEDROCK_MODEL_ID=anthropic.claude-3-5-sonnet-20241022-v2:0

# 6. NLSC CAD_001 認證（待核發帳密並確認官方認證契約）
NLSC_CAD_API_ENABLED=false
NLSC_CAD_AUTH_CONTRACT_VERIFIED=false
NLSC_CAD_API_USERNAME=
NLSC_CAD_API_TOKEN=

# 7. 地籍快照 S3：bucket 待提供；key/hash 是既有版本，更新資料時須一起更新。
CADASTRAL_SNAPSHOT_S3_BUCKET=
CADASTRAL_SNAPSHOT_S3_KEY=datasets/cadastral/v2026-09-06/cadastral_dataset_cache.sqlite3
CADASTRAL_SNAPSHOT_SHA256=d2ffbe849c21273a0a6602ce25b58e940d23125c9bba779b34e1a5b589656e42
# 本機留白沿用專案 data 路徑；Lambda 使用 /tmp/cadastral_dataset_cache.sqlite3。
CADASTRAL_DATASET_CACHE_DB_PATH=

# 8. 新北使用分區 GIS 快照（通常與地籍快照使用同一 bucket，請重複填值）
NTPC_ZONING_SNAPSHOT_S3_BUCKET=
NTPC_ZONING_SNAPSHOT_S3_KEY=datasets/ntpc-gis/v2026-09-09/ntpc_zoning.sqlite3
NTPC_ZONING_SNAPSHOT_SHA256=311b3e1705d7a3765fa9acf9c7a73a5c811228ff427822a921607fd20430125e
# Lambda 注入 /tmp/ntpc_zoning.sqlite3；本機留白。
NTPC_ZONING_RUNTIME_PATH=

# 9. 新北都市計畫範圍 GIS 快照
NTPC_PLAN_BOUNDARY_SNAPSHOT_S3_BUCKET=
NTPC_PLAN_BOUNDARY_SNAPSHOT_S3_KEY=datasets/ntpc-gis/v2026-09-08/ntpc_plan_boundary.sqlite3
NTPC_PLAN_BOUNDARY_SNAPSHOT_SHA256=a18393d0b5c0ea0e327684f1e5a2cb9ef196755a894bfcd4bc2d65d48dc1fad0
# Lambda 注入 /tmp/ntpc_plan_boundary.sqlite3；本機留白。
NTPC_PLAN_BOUNDARY_RUNTIME_PATH=

# 10. 本機案件、HTTP 與 SQLite 快取（留白保留各模組專案相對預設路徑）
PUBLIC_DATA_CASE_DIR=
PUBLIC_DATA_CACHE_DIR=
DATASET_REGISTRY_DB_PATH=
FACILITY_DATASET_CACHE_DB_PATH=
NLSC_CODE_CACHE_DB_PATH=
# Lambda GIS bootstrap 與 DATASET_REGISTRY_DB_PATH 須指向同一 runtime DB。
# Lambda 值：/tmp/runtime_dataset_registry.sqlite3；本機留白。
GIS_RUNTIME_REGISTRY_DB_PATH=
# AWS Lambda 自動提供，請勿在本機填值，否則會觸發 Lambda 路徑模式。
LAMBDA_TASK_ROOT=

# 11. 公開 API 清單（程式內固定端點，不讀取額外 .env key，以下僅供對照）
# 新北開放資料：https://data.ntpc.gov.tw/api/datasets
# NLSC：https://api.nlsc.gov.tw（ListCounty/ListTown/ListLandSection 等公開 API）
# NLSC 地圖：https://maps.nlsc.gov.tw/go/ 與 https://wmts.nlsc.gov.tw/wmts/
# OSM Nominatim：https://nominatim.openstreetmap.org/search
# OSM Overpass：https://overpass-api.de/api/interpreter
# Overpass 備援：https://overpass.kumi.systems/api/interpreter
# Overpass 備援：https://lz4.overpass-api.de/api/interpreter
# OSRM：https://router.project-osrm.org/route/v1/foot
# 以上公開服務沒有本專案需填寫的 API token；勿另造不會被程式讀取的變數。
