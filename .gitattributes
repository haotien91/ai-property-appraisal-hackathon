# Preserve the complete cadastral snapshot through Git LFS.
**/data/cadastral_dataset_cache.sqlite3 filter=lfs diff=lfs merge=lfs -text

# 本分支另有數個超過 GitHub 單檔 100MB 硬上限的資料集，一併走 LFS。
**/data/snapshots/*.sqlite3 filter=lfs diff=lfs merge=lfs -text
**/data/sources/gis/**/*.shp filter=lfs diff=lfs merge=lfs -text
**/data/sources/gis/**/*.zip filter=lfs diff=lfs merge=lfs -text
